# ==========================================
# Discord Configuration
# ==========================================
# Discord Bot Token from Discord Developer Portal
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Channel ID of the announcements channel to monitor (e.g., 123456789012345678)
DISCORD_CHANNEL_ID=123456789012345678

# ==========================================
# Telegram Configuration
# ==========================================
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Target Telegram Channel ID or @username
# For public channels: @your_channel_username
# For private channels: -1001234567890 (must include the -100 prefix)
TELEGRAM_CHAT_ID=-1001234567890

# ==========================================
# General & Timezone Settings
# ==========================================
# Local timezone used for scheduling, log timestamps, and event dates
# Examples: Europe/Helsinki, UTC, Europe/London, America/New_York
TIMEZONE=Europe/Helsinki

# ==========================================
# Bot Behavior Options
# ==========================================
# Mirror announcements posted by other bots or webhooks (e.g. Discohook)
# Values: true / false (default: true)
MIRROR_BOT_MESSAGES=true

# Add a header showing who posted the announcement (e.g., "📢 Announced by Username")
# Values: true / false (default: false)
SHOW_AUTHOR_HEADER=false

# Prepend category headers to Telegram posts (e.g. "-- Announcement --" vs "-- Upcoming Events --")
# Values: true / false (default: true)
ENABLE_MESSAGE_HEADERS=true
ANNOUNCEMENT_HEADER=-- Announcement --
EVENTS_HEADER=-- Upcoming Events --

# ==========================================
# Weekly Upcoming Events Digest
# ==========================================
# Automatically post a weekly summary of Discord Scheduled Events for the next 7 days
# Values: true / false (default: true)
ENABLE_WEEKLY_EVENTS=true

# Day of week to post digest: 0=Monday, 1=Tuesday, 2=Wednesday, 3=Thursday, 4=Friday, 5=Saturday, 6=Sunday
WEEKLY_EVENTS_DAY=0

# Time to post digest in your configured TIMEZONE (24-hour HH:MM format, e.g. 10:00 for 10am local time)
WEEKLY_EVENTS_TIME=10:00

# Also post the weekly events digest into the Discord #announcements channel
# (The digest is always posted to Telegram. Set to true if you also want it on Discord)
# Values: true / false (default: false)
POST_EVENTS_TO_DISCORD=false

# Catch-up grace window in hours if the bot was offline/rebooting at the scheduled time
# Set to 0 to disable catch-up (only dispatch if online at the exact time)
# Values: positive integer in hours (default: 8)
WEEKLY_EVENTS_GRACE_PERIOD_HOURS=8

# ==========================================
# Storage Configuration
# ==========================================
# SQLite Database path for message ID mappings
DATABASE_PATH=data/bot.db
